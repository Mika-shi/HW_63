@model MyChat.Models.User

@{
    ViewData["Title"] = Localizer["Title"];

    bool isMyProfile = ViewBag.IsMyProfile == true;
}

<div class="container mt-5">
    <div class="mx-auto" style="max-width: 650px;">
        
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        <h2 class="mb-4">@Localizer["UserProfile"]</h2>

        <div class="card">
            <div class="card-body">

                @if (!string.IsNullOrEmpty(Model.AvatarPath))
                {
                    <div class="text-center mb-4">
                        <img src="@Model.AvatarPath"
                             alt="@Localizer["AvatarAlt"]"
                             style="width: 150px;
                                    height: 150px;
                                    object-fit: cover;
                                    border-radius: 50%;"/>
                    </div>
                }

                <p>
                    <strong>@Localizer["Username"]</strong>
                    @Model.UserName
                </p>

                <p>
                    <strong>@Localizer["Email"]</strong>
                    @Model.Email
                </p>

                <p>
                    <strong>@Localizer["BirthDate"]</strong>
                    @Model.BirthDate.ToString("dd.MM.yyyy")
                </p>

                <p>
                    <strong>@Localizer["MessagesCount"]</strong>
                    @Model.MessagesCount
                </p>

                @if (isMyProfile)
                {
                    @if (!Model.EmailConfirmed)
                    {
                        <div class="alert alert-warning mt-3">
                            Email не подтверждён.

                            <form asp-controller="Profile" asp-action="SendConfirmationEmail"method="post"class="mt-2">

                                @Html.AntiForgeryToken()

                                <button type="submit"class="btn btn-warning">
                                    Подтвердить Email
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success mt-3">
                            Email подтверждён.
                        </div>
                    }

                    <a asp-controller="Profile"
                       asp-action="Edit"
                       class="btn btn-primary">
                        @Localizer["EditProfile"]
                    </a>

                    <form asp-controller="Profile"
                          asp-action="SendMyData"
                          method="post"
                          class="d-inline">
                        @Html.AntiForgeryToken()

                        <button type="submit" class="btn btn-outline-primary">
                            Отправить мои данные на Email
                        </button>
                    </form>
                }

            </div>
        </div>

    </div>
</div>