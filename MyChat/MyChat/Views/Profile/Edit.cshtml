@model MyChat.Models.User

@{
    ViewData["Title"] = Localizer["Title"];
}

<div class="container mt-5">
    <div class="mx-auto" style="max-width: 500px;">

        <h2 class="mb-4">@Localizer["Title"]</h2>

        <form asp-action="Edit"
              method="post"
              enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="mb-3">
                <label class="form-label">
                    @Localizer["Username"]
                </label>

                <input type="text"
                       name="userName"
                       value="@Model.UserName"
                       class="form-control" />

                <span class="text-danger">
                    @Html.ValidationMessage("userName")
                </span>
            </div>

            <div class="mb-3">
                <label class="form-label">
                    @Localizer["Email"]
                </label>

                <input type="email"
                       name="email"
                       value="@Model.Email"
                       class="form-control" />

                <span class="text-danger">
                    @Html.ValidationMessage("email")
                </span>
            </div>

            <div class="mb-3">
                <label class="form-label">
                    @Localizer["BirthDate"]
                </label>

                <input type="date"
                       name="birthDate"
                       value="@Model.BirthDate.ToString("yyyy-MM-dd")"
                       class="form-control" />

                <span class="text-danger">
                    @Html.ValidationMessage("birthDate")
                </span>
            </div>

            <div class="mb-3">
                <label class="form-label">
                    @Localizer["NewAvatar"]
                </label>

                <input type="file"
                       name="avatar"
                       class="form-control"
                       accept="image/*" />
            </div>

            <button type="submit"
                    class="btn btn-primary">
                @Localizer["SaveButton"]
            </button>

            <a asp-controller="Profile"
               asp-action="Details"
               class="btn btn-secondary">
                @Localizer["CancelButton"]
            </a>

        </form>

    </div>
</div>