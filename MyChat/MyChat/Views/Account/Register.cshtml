@model MyChat.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Регистрация";
}

<div class="container mt-5">
    <div class="mx-auto" style="max-width: 500px;">

        <h2 class="mb-4">Регистрация</h2>

        <form asp-action="Register"
              method="post"
              enctype="multipart/form-data"
              id="registerForm">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="mb-3">
                <label asp-for="UserName"
                       class="form-label">
                    Имя пользователя
                </label>

                <input asp-for="UserName"
                       class="form-control"
                       placeholder="Введите имя пользователя" />

                <span asp-validation-for="UserName"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Email"
                       class="form-label">
                    Email
                </label>

                <input asp-for="Email"
                       class="form-control"
                       placeholder="Введите email" />

                <span asp-validation-for="Email"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="BirthDate"
                       class="form-label">
                    Дата рождения
                </label>

                <input asp-for="BirthDate"
                       class="form-control"
                       type="date" />

                <span asp-validation-for="BirthDate"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Avatar"
                       class="form-label">
                    Аватар
                </label>

                <input asp-for="Avatar"
                       class="form-control"
                       type="file"
                       accept="image/*" />
            </div>

            <div class="mb-3">
                <label asp-for="Password"
                       class="form-label">
                    Пароль
                </label>

                <input asp-for="Password"
                       class="form-control"
                       id="passwordInput"
                       placeholder="Введите пароль" />

                <span asp-validation-for="Password"
                      class="text-danger">
                </span>

                <div id="passwordRules"
                     class="mt-2">

                    <div id="ruleLength"
                         class="text-danger">
                        Минимум 6 символов
                    </div>

                    <div id="ruleUpper"
                         class="text-danger">
                        Минимум 1 заглавная буква
                    </div>

                    <div id="ruleLower"
                         class="text-danger">
                        Минимум 1 строчная буква
                    </div>

                    <div id="ruleDigit"
                         class="text-danger">
                        Минимум 1 цифра
                    </div>

                </div>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword"
                       class="form-label">
                    Подтвердите пароль
                </label>

                <input asp-for="ConfirmPassword"
                       class="form-control"
                       id="confirmPasswordInput"
                       placeholder="Повторите пароль" />

                <span asp-validation-for="ConfirmPassword"
                      class="text-danger">
                </span>

                <div id="confirmPasswordError"
                     class="text-danger mt-1">
                </div>
            </div>

            <button type="submit"
                    class="btn btn-primary w-100">
                Зарегистрироваться
            </button>

        </form>

    </div>
</div>