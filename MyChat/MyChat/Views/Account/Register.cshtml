@model MyChat.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = Localizer["Title"];
}

<div class="container mt-5">
    <div class="mx-auto" style="max-width: 500px;">

        <h2 class="mb-4">>@Localizer["Title"]</h2>

        <form asp-action="Register"
              method="post"
              enctype="multipart/form-data"
              id="registerForm">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="mb-3">
                <label asp-for="UserName"
                       class="form-label">
                    @Localizer["Username"]
                </label>

                <input asp-for="UserName"
                       class="form-control"
                       placeholder="@Localizer["UsernamePlaceholder"]" />

                <span asp-validation-for="UserName"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Email"
                       class="form-label">
                    @Localizer["Email"]
                </label>

                <input asp-for="Email"
                       class="form-control"
                       placeholder="@Localizer["EmailPlaceholder"]" />

                <span asp-validation-for="Email"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="BirthDate"
                       class="form-label">
                    @Localizer["BirthDate"]
                </label>

                <input asp-for="BirthDate"
                       class="form-control"
                       type="date" />

                <span asp-validation-for="BirthDate"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Avatar"
                       class="form-label">
                    @Localizer["Avatar"]
                </label>

                <input asp-for="Avatar"
                       class="form-control"
                       type="file"
                       accept="image/*" />
            </div>

            <div class="mb-3">
                <label asp-for="Password"
                       class="form-label">
                    @Localizer["Password"]
                </label>

                <div class="input-group">
                    <input asp-for="Password"
                           class="form-control"
                           id="passwordInput"
                           placeholder="@Localizer["PasswordPlaceholder"]" />

                    <button type="button"
                            class="btn btn-outline-secondary password-toggle"
                            data-target="passwordInput">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>

                <span asp-validation-for="Password"
                      class="text-danger">
                </span>

                <div id="passwordRules" class="mt-2">
                    <div id="ruleLength" class="text-danger">
                        @Localizer["RuleLength"]
                    </div>

                    <div id="ruleUpper" class="text-danger">
                        @Localizer["RuleUpper"]
                    </div>

                    <div id="ruleLower" class="text-danger">
                        @Localizer["RuleLower"]
                    </div>

                    <div id="ruleDigit" class="text-danger">
                        @Localizer["RuleDigit"]
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword"
                       class="form-label">
                    @Localizer["ConfirmPassword"]
                </label>

                <div class="input-group">
                    <input asp-for="ConfirmPassword"
                           class="form-control"
                           id="confirmPasswordInput"
                           placeholder="@Localizer["ConfirmPasswordPlaceholder"]" />

                    <button type="button"
                            class="btn btn-outline-secondary password-toggle"
                            data-target="confirmPasswordInput">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>

                <span asp-validation-for="ConfirmPassword"
                      class="text-danger">
                </span>

                <div id="confirmPasswordError"
                     class="text-danger mt-1">
                </div>
            </div>

            <button type="submit"
                    class="btn btn-primary w-100">
                @Localizer["RegisterButton"]
            </button>

        </form>

    </div>
</div>