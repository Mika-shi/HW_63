@{
    ViewData["Title"] = Localizer["Title"];
}

<div class="container mt-5">
    <div class="mx-auto" style="max-width: 500px;">

        <h2 class="mb-4">@Localizer["Title"]</h2>

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label">@Localizer["Username"]</label>
                <input type="text" name="userName" class="form-control" />
                <span class="text-danger">@Html.ValidationMessage("userName")</span>
            </div>

            <div class="mb-3">
                <label class="form-label">@Localizer["Email"]</label>
                <input type="email" name="email" class="form-control" />
                <span class="text-danger">@Html.ValidationMessage("email")</span>
            </div>

            <div class="mb-3">
                <label class="form-label">@Localizer["BirthDate"]</label>
                <input type="date" name="birthDate" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">@Localizer["Password"]</label>
                <input type="password" name="password" class="form-control" />
            </div>

            <button type="submit" class="btn btn-primary">@Localizer["CreateButton"]</button>
            <a asp-action="Users" class="btn btn-secondary">@Localizer["CancelButton"]</a>

        </form>

    </div>
</div>