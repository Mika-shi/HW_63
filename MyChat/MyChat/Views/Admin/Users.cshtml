@model List<MyChat.Models.User>

@{
    ViewData["Title"] = "Пользователи";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Пользователи</h2>

        <a asp-controller="Admin"
           asp-action="Create"
           class="btn btn-primary">
            Создать пользователя
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <table class="table table-bordered table-striped">

        <thead>
        <tr>
            <th>Username</th>
            <th>Email</th>
            <th>Дата рождения</th>
            <th>Сообщения</th>
            <th>Статус</th>
            <th>Действия</th>
        </tr>
        </thead>

        <tbody>

        @foreach (User user in Model)
        {
            bool isBlocked =
                user.LockoutEnd.HasValue &&
                user.LockoutEnd.Value > DateTimeOffset.Now;

            <tr>

                <td>@user.UserName</td>

                <td>@user.Email</td>

                <td>
                    @user.BirthDate.ToString("dd.MM.yyyy")
                </td>

                <td>
                    @user.MessagesCount
                </td>

                <td>
                    @if (isBlocked)
                    {
                        <span class="text-danger">
                            Заблокирован
                        </span>
                    }
                    else
                    {
                        <span class="text-success">
                            Активен
                        </span>
                    }
                </td>

                <td>

                    <a asp-controller="Admin"
                       asp-action="Edit"
                       asp-route-id="@user.Id"
                       class="btn btn-warning btn-sm">
                        Редактировать
                    </a>

                    @if (isBlocked)
                    {
                        <form asp-controller="Admin"
                              asp-action="Unblock"
                              asp-route-id="@user.Id"
                              method="post"
                              class="d-inline">

                            <button type="submit" class="btn btn-success btn-sm">
                                Разблокировать
                            </button>

                        </form>
                    }
                    else
                    {
                        <form asp-controller="Admin"
                              asp-action="Block"
                              asp-route-id="@user.Id"
                              method="post"
                              class="d-inline">

                            <button type="submit" class="btn btn-danger btn-sm">
                                Заблокировать
                            </button>

                        </form>
                    }

                </td>

            </tr>
        }

        </tbody>

    </table>

</div>